                  <path d="M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160ZM176,24H80A56.06,56.06,0,0,0,24,80v96a56.06,56.06,0,0,0,56,56h96a56.06,56.06,0,0,0,56-56V80A56.06,56.06,0,0,0,176,24Zm40,152a40,40,0,0,1-40,40H80a40,40,0,0,1-40-40V80A40,40,0,0,1,80,40h96a40,40,0,0,1,40,40ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"></path>
                </svg>
              </div>
            </a>

          </div>

        </div>

      </div>
    </div>
  </footer>

  <!-- ========================================================================
       INTERACTIVITY & ANIMATIONS SCRIPT (Hanzo + LinguaPro Behaviors)
       ======================================================================== -->
  <script is:inline>
    (function () {
      // 1. Initialize Lucide Icons
      if (window.lucide) {
        lucide.createIcons();
      }

      // 2. Mobile Menu Toggle (Hanzo 2-bar rotation)
      var mobileBtn = document.getElementById('mobile-menu-btn');
      var mobilePanel = document.getElementById('mobile-menu-panel');
      if (mobileBtn && mobilePanel) {
        mobileBtn.addEventListener('click', function () {
          var isOpen = mobileBtn.classList.toggle('is-open');
          mobilePanel.classList.toggle('hidden', !isOpen);
          mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        document.querySelectorAll('.mobile-nav-link').forEach(function (link) {
          link.addEventListener('click', function () {
            mobileBtn.classList.remove('is-open');
            mobilePanel.classList.add('hidden');
            mobileBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // 3. Search Drawer Toggle
      var searchBtns = [
        document.getElementById('search-toggle-btn'),
        document.getElementById('mobile-search-btn')
      ];
      var searchDrawer = document.getElementById('search-drawer');
      var searchClose = document.getElementById('search-close-btn');

      searchBtns.forEach(function (btn) {
        if (!btn || !searchDrawer) return;
        btn.addEventListener('click', function () {
          var isHidden = searchDrawer.classList.toggle('hidden');
          if (!isHidden) {
            var input = searchDrawer.querySelector('input');
            if (input) input.focus();
          }
        });
      });

      if (searchClose && searchDrawer) {
        searchClose.addEventListener('click', function () {
          searchDrawer.classList.add('hidden');
        });
      }

      // 4. FAQ Accordion (Hanzo rotating orange plus)
      var faqItems = document.querySelectorAll('.hanzo-faq-item');
      faqItems.forEach(function (item) {
        var btn = item.querySelector('.faq-trigger');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var currentlyOpen = item.classList.contains('is-open');
          item.classList.toggle('is-open', !currentlyOpen);
          btn.setAttribute('aria-expanded', !currentlyOpen ? 'true' : 'false');
        });
      });

      // 5. Hanzo Scroll-Driven Word Opacity Reveal (0.25 -> 1.0) on Sobre Lead Text
      var leadEl = document.getElementById('sobre-lead-reveal');
      var wordSpans = [];
      if (leadEl) {
        var rawText = leadEl.textContent.trim().replace(/\s+/g, ' ');
        var words = rawText.split(' ');
        leadEl.innerHTML = words
          .map(function (w) {
            return '<span class="scroll-word" style="opacity:0.28">' + w + '</span>';
          })
          .join(' ');
        wordSpans = Array.prototype.slice.call(leadEl.querySelectorAll('.scroll-word'));
      }

      function updateWordReveal() {
        if (!leadEl || !wordSpans.length) return;
        var rect = leadEl.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        // Progress from when top enters 85% of viewport to when it reaches 35%
        var start = vh * 0.88;
        var end = vh * 0.32;
        var progress = (start - rect.top) / Math.max(1, start - end);
        progress = Math.max(0, Math.min(1, progress));

        var total = wordSpans.length;
        wordSpans.forEach(function (span, idx) {
          var wordThreshold = idx / total;
          var local = (progress - wordThreshold * 0.75) / 0.25;
          local = Math.max(0, Math.min(1, local));
          var opacity = 0.25 + local * 0.75;
          span.style.opacity = opacity.toFixed(3);
        });
      }

      // 6. Scroll Reveal Observer for cards, sections, and SVG scribbles
      var revealEls = document.querySelectorAll('.reveal-on-scroll');
      var scribbleEls = document.querySelectorAll('.scribble-trigger');

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealEls.forEach(function (el) {
          io.observe(el);
        });

        var scribbleIo = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('scribble-visible');
              }
            });
          },
          { threshold: 0.25 }
        );
        scribbleEls.forEach(function (el) {
          scribbleIo.observe(el);
        });
      } else {
        revealEls.forEach(function (el) {
          el.classList.add('is-visible');
        });
        scribbleEls.forEach(function (el) {
          el.classList.add('scribble-visible');
        });
      }

      // 7. Smart Header Auto-Hide on Scroll Down / Reveal on Scroll Up
      var headerEl = document.getElementById('main-header');
      if (headerEl) {
        var lastScrollY = window.pageYOffset || document.documentElement.scrollTop;
        
      // 9. Croma Design System Infinite Gallery Interactions (Drag-to-Scroll & Navigation)
      var galleryViewport = document.getElementById('croma-gallery-viewport');
      var prevBtn = document.getElementById('croma-prev-btn');
      var nextBtn = document.getElementById('croma-next-btn');

      if (galleryViewport) {
        var isDown = false;
        var startX;
        var scrollLeft;

        galleryViewport.addEventListener('mousedown', function (e) {
          isDown = true;
          galleryViewport.classList.add('is-dragging');
          startX = e.pageX - galleryViewport.offsetLeft;
          scrollLeft = galleryViewport.scrollLeft;
        });

        galleryViewport.addEventListener('mouseleave', function () {
          isDown = false;
          galleryViewport.classList.remove('is-dragging');
        });

        galleryViewport.addEventListener('mouseup', function () {
          isDown = false;
          galleryViewport.classList.remove('is-dragging');
        });

        galleryViewport.addEventListener('mousemove', function (e) {
          if (!isDown) return;
          e.preventDefault();
          var x = e.pageX - galleryViewport.offsetLeft;
          var walk = (x - startX) * 1.5; // Scroll speed factor
          galleryViewport.scrollLeft = scrollLeft - walk;
        });

        // Wheel horizontal glide
        galleryViewport.addEventListener('wheel', function (e) {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            var canScrollRight = galleryViewport.scrollLeft < (galleryViewport.scrollWidth - galleryViewport.clientWidth - 5);
            var canScrollLeft = galleryViewport.scrollLeft > 5;
            if ((e.deltaY > 0 && canScrollRight) || (e.deltaY < 0 && canScrollLeft)) {
              e.preventDefault();
              galleryViewport.scrollBy({ left: e.deltaY * 1.2, behavior: 'auto' });
            }
          }
        }, { passive: false });

        // Navigation Arrows
        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            galleryViewport.scrollBy({ left: -360, behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            galleryViewport.scrollBy({ left: 360, behavior: 'smooth' });
          });
        }
      }

      window.addEventListener('scroll', function () {
          var currentScrollY = window.pageYOffset || document.documentElement.scrollTop;
          if (currentScrollY > 100 && currentScrollY > lastScrollY) {
            headerEl.style.transform = 'translateY(-130%)';
          } else {
            headerEl.style.transform = 'translateY(0)';
          }
          lastScrollY = currentScrollY;
        }, { passive: true });
      }

      // 8. Scroll-Driven Footer Emergence (Hanzo scroll-linked copy reveal from design-system.html)
      var footerEl = document.getElementById('main-footer');
      var footerShell = footerEl ? footerEl.querySelector('.hanzo-footer-shell') : null;
      var footerRays = footerEl ? footerEl.querySelector('.hanzo-footer-rays') : null;
      var footerCtaBlock = document.getElementById('footer-cta-block');
      var footerBottomBar = document.getElementById('footer-bottom-bar');

      function updateFooterScroll() {
        if (!footerEl || !footerCtaBlock) return;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var rect = footerShell ? footerShell.getBoundingClientRect() : footerEl.getBoundingClientRect();

        // Total distance over which the animation unfolds as user scrolls into the footer:
        // Starts when the top of the footer shell enters the bottom of the viewport (rect.top <= vh)
        // Reaches 100% when card is comfortably centered in view
        var totalDistance = Math.min(vh * 0.65, rect.height * 0.75);
        var currentDistance = vh - rect.top;
        var progress = currentDistance / Math.max(1, totalDistance);
        progress = Math.max(0, Math.min(1, progress));

        // Hanzo CTA descent: starts clipped at top border with negative translateY (-280px),
        // descends smoothly downwards to 0px as the user scrolls down, with full crisp opacity reaching 1.0
        var ctaY = (1 - progress) * -280;
        var ctaOpacity = 0.35 + progress * 0.65;
        if (progress >= 0.80) ctaOpacity = 1.0;

        footerCtaBlock.style.transform = 'translate3d(0, ' + ctaY.toFixed(1) + 'px, 0)';
        footerCtaBlock.style.opacity = ctaOpacity.toFixed(3);

        // Subtle ambient light rays (capped at max 0.06 opacity so dark background remains crisp and deep)
        if (footerRays) {
          var rayY = (1 - progress) * -30;
          var rayOpacity = 0.03 + progress * 0.03;
          footerRays.style.transform = 'translate3d(0, ' + rayY.toFixed(1) + 'px, 0)';
          footerRays.style.opacity = rayOpacity.toFixed(3);
        }

        // Bottom bar (copyright & social icons)
        if (footerBottomBar) {
          var pBar = Math.max(0, Math.min(1, (progress - 0.30) / 0.50));
          var opBar = 0.40 + pBar * 0.60;
          var yBar = (1 - pBar) * 12;
          footerBottomBar.style.opacity = opBar.toFixed(3);
          footerBottomBar.style.transform = 'translate3d(0, ' + yBar.toFixed(1) + 'px, 0)';
        }

        // Hide floating header when approaching footer so it doesn't obstruct the framed card
        if (headerEl) {
          if (rect.top < vh * 0.9) {
            headerEl.style.transform = 'translateY(-130%)';
            headerEl.style.opacity = '0';
            headerEl.style.pointerEvents = 'none';
          } else {
            headerEl.style.opacity = '1';
            headerEl.style.pointerEvents = 'auto';
          }
        }
      }

      // Interactive subtle spotlight tracking inside Hanzo footer shell
      if (footerShell) {
        footerShell.addEventListener('mousemove', function (e) {
          var r = footerShell.getBoundingClientRect();
          var x = e.clientX - r.left;
          var y = e.clientY - r.top;
          footerShell.style.setProperty('--fx', x + 'px');
          footerShell.style.setProperty('--fy', y + 'px');
        });
      }


      window.addEventListener('scroll', function () {
        updateWordReveal();
        updateFooterScroll();
      }, { passive: true });
      window.addEventListener('resize', function () {
        updateWordReveal();
        updateFooterScroll();
      }, { passive: true });
      updateWordReveal();
      updateFooterScroll();
    })();
  </script>
</body>
</html>
