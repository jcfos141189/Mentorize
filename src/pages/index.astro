---
// Mentorize - Plataforma de Mentoria On-line
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mentorize | A Sua Mais Nova Plataforma de Mentoria On-line</title>
  <meta name="description" content="Mentorize é a Sua Plataforma de Mentoria On-line, Onde Você Poderá Encontrar Os Melhores Profissionais Para Alavancar a Sua Carreira. Clique Agora Para Conhecer!" />
  <link rel="canonical" href="https://mentorize.com.br/" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Mentorize | A Sua Mais Nova Plataforma de Mentoria On-line" />
  <meta property="og:description" content="Mentorize é a Sua Plataforma de Mentoria On-line, Onde Você Poderá Encontrar Os Melhores Profissionais Para Alavancar a Sua Carreira. Clique Agora Para Conhecer!" />
  <meta property="og:url" content="https://mentorize.com.br/" />
  <meta property="og:site_name" content="Mentorize" />

  <!-- Favicons -->
  <link rel="shortcut icon" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" href="/assets/favicon-32x32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/assets/favicon-192x192.png" />

  <!-- Embedded Hanzo Fonts (Inter Display, Inter, Instrument Serif) + Google Fonts fallback -->
  <link rel="stylesheet" href="/assets/hanzo-fonts.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Local Tailwind Play CDN (from LinguaPro DS) -->
  <script is:inline src="/assets/tailwind.js"></script>
  <!-- Local Lucide Icons (from LinguaPro DS) -->
  <script is:inline src="/assets/lucide.min.js"></script>

  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: {
              DEFAULT: '#24576a',
              50: '#edf5f7',
              100: '#d9e9ed',
              200: '#b5d3dc',
              700: '#1e4959',
              800: '#183b48',
              900: '#24576a',
              950: '#132e38'
            },
            coral: {
              DEFAULT: '#c0861a',
              hover: '#aa7514',
              hanzo: '#c0861a'
            },
            hanzo: {
              field: '#d9e9ed',
              ink: '#24576a',
              orange: '#c0861a'
            }
          },
          fontFamily: {
            sans: ['"Inter Display"', '"Inter"', 'system-ui', '-apple-system', 'sans-serif'],
            serif: ['"Instrument Serif"', 'Georgia', 'serif']
          }
        }
      }
    };
  </script>

  <style is:global>
    :root {
      --token-navy-900: #24576a;
      --token-navy: #24576a;
      --token-navy-50: #edf5f7;
      --token-coral: #c0861a;
      --token-coral-hover: #aa7514;
      --token-hanzo-orange: #c0861a;
      --token-field: #d9e9ed;
    }

    * {
      box-sizing: border-box;
    }

    ::selection {
      background-color: var(--token-hanzo-orange);
      color: #FFFFFF;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: "Inter Display", "Inter", system-ui, -apple-system, sans-serif;
      background: linear-gradient(225deg, #F8FAFC 0%, #edf5f7 55%, #d9e9ed 100%);
      color: #24576a;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ==========================================================================
       HANZO FIXED GRAIN & SKEWED LIGHT RAYS
       ========================================================================== */
    .hanzo-noise {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 40;
      opacity: 0.04;
      background-image: url("/assets/noise.png");
      background-repeat: repeat;
      background-size: 150px auto;
    }

    .hanzo-rays-field {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .hanzo-ray {
      position: absolute;
      top: -20%;
      bottom: -20%;
      width: 18%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.22) 65%, rgba(255, 255, 255, 0) 100%);
      transform: skewX(45deg);
      filter: blur(2px);
    }

    .hanzo-ray-dark {
      position: absolute;
      top: -25%;
      bottom: -25%;
      width: 16%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.09) 0%, rgba(36, 87, 106, 0.14) 60%, rgba(255, 255, 255, 0) 100%);
      transform: skewX(45deg);
    }

    /* ==========================================================================
       HANZO TYPOGRAPHY PRESETS & EYEBROW RULES
       ========================================================================== */
    .hanzo-display {
      font-family: "Inter Display", "Inter", sans-serif;
      font-weight: 500;
      letter-spacing: -0.055em;
      line-height: 1.07;
    }

    .hanzo-h2 {
      font-family: "Inter Display", "Inter", sans-serif;
      font-weight: 500;
      letter-spacing: -0.04em;
      line-height: 1.18;
    }

    .hanzo-numeral {
      font-family: "Inter Display", "Inter", sans-serif;
      font-weight: 400;
      font-size: clamp(48px, 5vw, 72px);
      letter-spacing: -0.05em;
      line-height: 1;
    }

    .hanzo-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    .hanzo-eyebrow-text {
      font-family: "Instrument Serif", Georgia, serif;
      font-style: italic;
      font-weight: 400;
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: 0;
    }

    .hanzo-rule-left {
      width: 56px;
      height: 1px;
      background: linear-gradient(90deg, rgba(36, 87, 106, 0) 0%, rgba(36, 87, 106, 0.45) 100%);
    }

    .hanzo-rule-right {
      width: 56px;
      height: 1px;
      background: linear-gradient(270deg, rgba(36, 87, 106, 0) 0%, rgba(36, 87, 106, 0.45) 100%);
    }

    .hanzo-rule-left-light {
      width: 56px;
      height: 1px;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.5) 100%);
    }

    .hanzo-rule-right-light {
      width: 56px;
      height: 1px;
      background: linear-gradient(270deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.5) 100%);
    }

    /* ==========================================================================
       HANZO SURFACES, 8PX RINGS & TILTED CARDS
       ========================================================================== */
    .hanzo-card {
      background-color: #FFFFFF;
      border-radius: 20px;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.45),
        12px 16px 24px -4px rgba(36, 87, 106, 0.09);
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hanzo-card:hover {
      transform: rotate(0deg) translateY(-6px) !important;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.7),
        16px 24px 36px -6px rgba(36, 87, 106, 0.14);
    }

    .hanzo-glass-card {
      background: rgba(255, 255, 255, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 24px;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.32),
        12px 16px 24px -4px rgba(36, 87, 106, 0.08);
    }

    .hanzo-dark-frame {
      background-color: #24576a;
      border-radius: 28px;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.28),
        16px 24px 40px -8px rgba(36, 87, 106, 0.28);
    }

    .hanzo-pill-chip {
      background-color: #FFFFFF;
      border: 1px solid #FFFFFF;
      border-radius: 9999px;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.32),
        10px 14px 18px 0 rgba(36, 87, 106, 0.08);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hanzo-pill-chip:hover {
      transform: rotate(0deg) scale(1.03) !important;
    }

    /* ==========================================================================
       HANZO × LINGUAPRO PILL BUTTONS WITH DUAL SLIDING ARROWS
       ========================================================================== */
    .hanzo-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 20px 14px 26px;
      border-radius: 9999px;
      font-weight: 500;
      font-size: 15px;
      letter-spacing: -0.01em;
      text-decoration: none;
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, background-color 0.25s ease;
      cursor: pointer;
    }

    .hanzo-btn:hover {
      transform: translateY(-2px);
    }

    .hanzo-btn:active {
      transform: translateY(0);
    }

    .hanzo-btn-coral {
      background-color: #c0861a;
      color: #FFFFFF;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.2),
        0 14px 30px -6px rgba(192, 134, 26, 0.45),
        inset 0 -14px 32px rgba(150, 100, 15, 0.35);
    }

    .hanzo-btn-coral:hover {
      background-color: #aa7514;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.3),
        0 18px 36px -6px rgba(192, 134, 26, 0.6),
        inset 0 -14px 32px rgba(130, 85, 10, 0.4);
    }

    .hanzo-btn-navy {
      background-color: #24576a;
      color: #FFFFFF;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.45),
        0 14px 30px -6px rgba(36, 87, 106, 0.32),
        inset 0 -14px 36px rgba(0, 0, 0, 0.45);
    }

    .hanzo-btn-navy:hover {
      background-color: #1e4959;
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.65),
        0 18px 36px -6px rgba(36, 87, 106, 0.4),
        inset 0 -14px 36px rgba(0, 0, 0, 0.35);
    }

    .hanzo-btn-glass {
      background-color: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: #FFFFFF;
      border: 1px solid rgba(255, 255, 255, 0.24);
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.06),
        0 12px 28px -6px rgba(0, 0, 0, 0.25);
    }

    .hanzo-btn-glass:hover {
      background-color: rgba(255, 255, 255, 0.2);
      border-color: rgba(255, 255, 255, 0.38);
      box-shadow:
        0 0 0 8px rgba(255, 255, 255, 0.12),
        0 16px 32px -6px rgba(0, 0, 0, 0.32);
    }

    /* Dual sliding arrow slot */
    .hanzo-arrow-slot {
      position: relative;
      width: 28px;
      height: 28px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.16);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    .hanzo-arrow-1,
    .hanzo-arrow-2 {
      position: absolute;
      width: 16px;
      height: 16px;
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.38s ease;
    }

    .hanzo-arrow-1 {
      transform: translateX(0);
      opacity: 0.9;
    }

    .hanzo-arrow-2 {
      transform: translateX(-22px);
      opacity: 0;
    }

    .hanzo-btn:hover .hanzo-arrow-1 {
      transform: translateX(22px);
      opacity: 0;
    }

    .hanzo-btn:hover .hanzo-arrow-2 {
      transform: translateX(0);
      opacity: 1;
    }

    /* ==========================================================================
       HANZO MENU ICON BUTTON (2 BARS -> ROTATE ±45°)
       ========================================================================== */
    .hanzo-menu-toggle {
      width: 44px;
      height: 44px;
      border-radius: 9999px;
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25), 0 6px 14px rgba(36, 87, 106, 0.12);
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      border: 1px solid rgba(36, 87, 106, 0.15);
      transition: transform 0.25s ease, background-color 0.25s ease;
    }

    .hanzo-menu-bar {
      width: 18px;
      height: 2px;
      background-color: #24576a;
      border-radius: 10px;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: 50% 50%;
    }

    .hanzo-menu-toggle.is-open .hanzo-menu-bar-top {
      transform: translateY(3.5px) rotate(45deg);
    }

    .hanzo-menu-toggle.is-open .hanzo-menu-bar-bottom {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    /* ==========================================================================
       BLUR-TO-SHARP WORD & SCROLL REVEAL ANIMATIONS
       ========================================================================== */
    .blur-word {
      display: inline-block;
      opacity: 0;
      filter: blur(10px);
      transform: translateY(14px);
      animation: hanzoBlurIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes hanzoBlurIn {
      to {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0);
      }
    }

    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .scroll-word {
      transition: opacity 0.25s ease, filter 0.25s ease;
      will-change: opacity, filter;
    }

    /* Hand-drawn SVG scribble path animation */
    .scribble-path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .scribble-visible .scribble-path {
      stroke-dashoffset: 0;
    }

    /* ==========================================================================
       HANZO FAQ ACCORDION (HAIRLINE + ROTATING ORANGE/CORAL PLUS)
       ========================================================================== */
    .hanzo-faq-item {
      border-bottom: 1px solid rgba(36, 87, 106, 0.16);
      transition: background-color 0.25s ease;
    }

    .hanzo-faq-item:first-child {
      border-top: 1px solid rgba(36, 87, 106, 0.16);
    }

    .hanzo-faq-plus {
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s ease;
      color: #c0861a;
    }

    .hanzo-faq-item.is-open .hanzo-faq-plus {
      transform: rotate(45deg);
      color: #c0861a;
    }

    .hanzo-faq-answer {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.32s ease, padding 0.32s ease;
    }

    .hanzo-faq-item.is-open .hanzo-faq-answer {
      max-height: 520px;
      opacity: 1;
      padding-bottom: 28px;
    }

    /* ==========================================================================
       HANZO FRAMED FOOTER (DEEP NAVY BLUE WITH SCROLL-DRIVEN REVEAL)
       ========================================================================== */
    .hanzo-footer-shell {
      position: relative;
      border: 8px solid #d9e9ed;
      background: radial-gradient(120% 120% at 20% 0%, #24576a 0%, #173b47 45%, #0e222a 100%);
      border-radius: 40px;
      overflow: hidden;
      box-shadow: 0 24px 60px -15px rgba(14, 34, 42, 0.6);
      isolation: isolate;
    }

    /* Interactive Ambient Mouse Spotlight */
    .hanzo-footer-spotlight {
      position: absolute;
      inset: 0;
      background: radial-gradient(650px circle at var(--fx, 50%) var(--fy, 50%), rgba(255, 255, 255, 0.05), transparent 50%);
      pointer-events: none;
      z-index: 2;
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .hanzo-footer-shell:hover .hanzo-footer-spotlight {
      opacity: 1;
    }

    /* Masked Diagonal Light Rays (.framer-nilurh) with Scroll Emergence & Ambient Sweep */
    .hanzo-footer-rays {
      pointer-events: none;
      z-index: 1;
      position: absolute;
      inset: 0;
      overflow: hidden;
      opacity: 0.05;
      mask: radial-gradient(125% 100% at 0% 0%, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0.224) 88.2883%, rgba(0, 0, 0, 0) 100%);
      -webkit-mask: radial-gradient(125% 100% at 0% 0%, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0.224) 88.2883%, rgba(0, 0, 0, 0) 100%);
      will-change: transform, opacity;
      transform: translate3d(0, 0, 0);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease-out;
    }

    .hanzo-ray-beam {
      position: absolute;
      top: -209px;
      height: 1269px;
      max-width: 960px;
      transform: skewX(45deg);
      opacity: 0.05;
      overflow: hidden;
      will-change: transform, opacity;
      animation: hanzoRaySweep 14s ease-in-out infinite alternate;
    }

    .hanzo-ray-1 {
      width: 591px;
      left: calc(33.6% - 295px);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 83.9%, rgba(255, 255, 255, 0) 100%);
      mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0) 36%, rgb(0,0,0) 55%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78.2%, rgba(0,0,0,0) 97.3%);
      -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0) 36%, rgb(0,0,0) 55%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78.2%, rgba(0,0,0,0) 97.3%);
      animation-delay: 0s;
    }

    .hanzo-ray-2 {
      width: 582px;
      left: calc(-1.5% - 291px);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 83.9%, rgba(255, 255, 255, 0) 100%);
      mask: linear-gradient(90deg, rgba(0,0,0,0) 11.4%, rgb(0,0,0) 25.5%, rgba(0,0,0,0.55) 41.7%, rgba(0,0,0,0.13) 67.1%, rgb(0,0,0) 78.2%, rgba(0,0,0,0) 97.3%);
      -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 11.4%, rgb(0,0,0) 25.5%, rgba(0,0,0,0.55) 41.7%, rgba(0,0,0,0.13) 67.1%, rgb(0,0,0) 78.2%, rgba(0,0,0,0) 97.3%);
      animation-delay: -3s;
    }

    .hanzo-ray-3 {
      width: 441px;
      left: calc(33.7% - 220px);
      background: linear-gradient(180deg, #fff 0%, #fff 67%, rgba(255,255,255,0) 100%);
      mask: linear-gradient(90deg, rgba(0,0,0,0) 9.8%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 28.6%, rgba(0,0,0,0.42) 40%, rgb(0,0,0) 48.6%, rgba(0,0,0,0.27) 54.5%, rgba(0,0,0,0.13) 78.6%, rgb(0,0,0) 88.5%, rgba(0,0,0,0) 97.3%);
      -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 9.8%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 28.6%, rgba(0,0,0,0.42) 40%, rgb(0,0,0) 48.6%, rgba(0,0,0,0.27) 54.5%, rgba(0,0,0,0.13) 78.6%, rgb(0,0,0) 88.5%, rgba(0,0,0,0) 97.3%);
      animation-delay: -6s;
    }

    .hanzo-ray-4 {
      width: 684px;
      left: calc(50.1% - 341px);
      background: linear-gradient(180deg, #fff 0%, #fff 83.9%, rgba(255,255,255,0) 100%);
      mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 17.6%, rgba(0,0,0,0.55) 26.6%, rgb(0,0,0) 35.2%, rgba(0,0,0,0.47) 47.7%, rgba(0,0,0,0.13) 69.2%, rgb(0,0,0) 79.1%, rgba(0,0,0,0) 97.3%);
      -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 17.6%, rgba(0,0,0,0.55) 26.6%, rgb(0,0,0) 35.2%, rgba(0,0,0,0.47) 47.7%, rgba(0,0,0,0.13) 69.2%, rgb(0,0,0) 79.1%, rgba(0,0,0,0) 97.3%);
      animation-delay: -9s;
    }

    .hanzo-ray-5 {
      width: 426px;
      left: calc(49.1% - 213px);
      background: linear-gradient(180deg, #fff 0%, #fff 83.9%, rgba(255,255,255,0) 100%);
      mask: linear-gradient(90deg, rgba(0,0,0,0) 12%, rgb(0,0,0) 26.5%, rgba(0,0,0,0.55) 34.6%, rgba(0,0,0,0.28) 42.7%, rgb(0,0,0) 50.2%, rgba(0,0,0,0.45) 59.5%, rgba(0,0,0,0.13) 76.5%, rgb(0,0,0) 86.8%, rgba(0,0,0,0) 97.3%);
      -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 12%, rgb(0,0,0) 26.5%, rgba(0,0,0,0.55) 34.6%, rgba(0,0,0,0.28) 42.7%, rgb(0,0,0) 50.2%, rgba(0,0,0,0.45) 59.5%, rgba(0,0,0,0.13) 76.5%, rgb(0,0,0) 86.8%, rgba(0,0,0,0) 97.3%);
      animation-delay: -11s;
    }

    @keyframes hanzoRaySweep {
      0% {
        transform: skewX(45deg) translate3d(0, 0, 0);
        opacity: 0.03;
      }
      50% {
        transform: skewX(43deg) translate3d(24px, -12px, 0);
        opacity: 0.06;
      }
      100% {
        transform: skewX(47deg) translate3d(-18px, 14px, 0);
        opacity: 0.04;
      }
    }

    /* Subtle Film Grain Noise inside Footer Shell */
    .hanzo-footer-noise {
      position: absolute;
      inset: 0;
      background-image: url('/assets/noise.png');
      opacity: 0.03;
      pointer-events: none;
      z-index: 2;
    }

    /* Scroll-Driven Footer Content Container */
    .hanzo-footer-content {
      position: relative;
      z-index: 10;
    }

    

    /* Hanzo Dark Pill CTA Button (media_1795036025784_3a95c5df.jpg) */
